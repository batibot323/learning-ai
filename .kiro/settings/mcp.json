{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "fetch"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Source/personal/learning-ai"
      ],
      "disabled": false,
      "autoApprove": [
        "list_directory"
      ]
    },
    "time-tools": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:/Source/personal/learning-ai/my-mcp-server",
        "python",
        "server.py"
      ],
      "disabled": false,
      "autoApprove": []
    },
    "dragonpay-test": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:/Source/personal/learning-ai/dragonpay-test",
        "python",
        "server.py"
      ],
      "disabled": false,
      "autoApprove": [
        "create_payment",
        "check_payment_status"
      ]
    },
    "code-analyzer": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:/Source/personal/learning-ai/code-analyzer-mcp",
        "python",
        "server.py"
      ],
      "disabled": false,
      "autoApprove": [
        "list_functions"
      ]
    }
  }
}